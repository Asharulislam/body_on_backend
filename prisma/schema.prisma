generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum NotificationType {
    gym_approved
    gym_rejected
    account_locked
    general
}

enum Role {
    customer
    gym_owner
    super_admin
}

enum GymStatus {
    pending
    approved
    rejected
}

model User {
    id              String         @id @default(uuid())
    fullName        String
    email           String         @unique
    passwordHash    String
    profileImageKey String?
    role            Role           @default(customer)
    isLocked        Boolean        @default(false)
    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt
    gym             Gym?
    notifications   Notification[]
    deviceTokens    DeviceToken[]
}

model Gym {
    id              String     @id @default(uuid())
    gymName         String
    description     String?
    address         String
    city            String
    phone           String?
    gymStatus       GymStatus  @default(pending)
    rejectionReason String?
    ownerId         String     @unique
    owner           User       @relation(fields: [ownerId], references: [id])
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt
    gymImages       GymImage[]
    machines        Machine[]
}

model GymImage {
    id        String   @id @default(uuid())
    imageKey  String
    gymId     String
    gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
}

model Machine {
    id          String   @id @default(uuid())
    machineName String
    description String
    imageKey    String
    gymId       String
    gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Notification {
    id        String           @id @default(uuid())
    userId    String
    user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    type      NotificationType @default(general)
    title     String
    body      String
    isRead    Boolean          @default(false)
    createdAt DateTime         @default(now())
}

model DeviceToken {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    token     String   @unique
    createdAt DateTime @default(now())
}
