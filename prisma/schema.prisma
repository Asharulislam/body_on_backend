generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    customer
    gym_owner
    super_admin
}

enum GymStatus {
    pending
    approved
    rejected
}

model User {
    id           String   @id @default(uuid())
    fullName     String
    email        String   @unique
    passwordHash String
    role         Role     @default(customer)
    isLocked     Boolean  @default(false)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    gym          Gym?
}

model Gym {
    id              String     @id @default(uuid())
    gymName         String
    description     String?
    address         String
    city            String
    phone           String?
    gymStatus       GymStatus  @default(pending)
    rejectionReason String?
    ownerId         String     @unique
    owner           User       @relation(fields: [ownerId], references: [id])
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt
    gymImages       GymImage[]
}

model GymImage {
    id        String   @id @default(uuid())
    key       String
    gymId     String
    gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
}
