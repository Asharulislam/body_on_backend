generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  gym_owner
  super_admin
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(customer)
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}